{
  "categories": [
    {
      "id": "bodycam",
      "name": "📹 Bodycam",
      "icon": "📹",
      "expanded": true,
      "commands": [
        {
          "id": "gen-bodycam-on",
          "text": "/me clips the {dept} bodycam to their chest and presses record",
          "palette": { "title": "Start Bodycam", "icon": "📹", "keywords": ["bodycam", "record", "start"] }
        },
        { "id": "gen-bodycam-check", "text": "/do The bodycam's red light is on; it is recording." },
        {
          "id": "gen-bodycam-save",
          "text": "/me stops the recording and uploads the footage to the {dept} evidence server",
          "palette": { "title": "Save Bodycam Footage", "icon": "💾", "keywords": ["bodycam", "save", "upload", "evidence"] }
        }
      ]
    },
    {
      "id": "traffic",
      "name": "🚗 Traffic Stop",
      "icon": "🚗",
      "commands": [
        { "id": "gen-ts-1", "text": "/me runs the plate through the {dept} MDT" },
        { "id": "gen-ts-2", "text": "/me approaches the driver's window and asks for license and registration" }
      ]
    },
    {
      "id": "arrest",
      "name": "🔗 Arrest",
      "icon": "🔗",
      "commands": [
        { "id": "gen-arrest-1", "text": "/me places the suspect in handcuffs and double-locks them" },
        {
          "id": "gen-miranda",
          "text": "/me reads the suspect their rights: You have the right to remain silent. Anything you say can and will be used against you. You have the right to an attorney.",
          "palette": { "title": "Read Rights", "icon": "⚖️", "keywords": ["miranda", "rights", "arrest"] }
        }
      ]
    }
  ],
  "radio": [
    {
